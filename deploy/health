#!/usr/bin/env bash
# Check that the user service is active and the tracker itself answers on its dedicated loopback port: /healthz must
# return the tracker's identity line, so another application's HTTP 200 on the port never counts as healthy.
# Environment: DEPLOY_HEALTH_URL (default http://127.0.0.1:8790/healthz), DEPLOY_HEALTH_WINDOW_SECONDS (60),
# DEPLOY_HEALTH_INTERVAL_SECONDS (2), DEPLOY_HEALTH_REQUEST_SECONDS (10).
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/common.sh"

url="${DEPLOY_HEALTH_URL:-http://127.0.0.1:8790/healthz}"
window="${DEPLOY_HEALTH_WINDOW_SECONDS:-60}"
interval="${DEPLOY_HEALTH_INTERVAL_SECONDS:-2}"
request="${DEPLOY_HEALTH_REQUEST_SECONDS:-10}"
# Never print URLs or response bodies.
[[ "$url" =~ ^https?://[^/@[:space:]]+([/?#].*)?$ ]] || die "invalid health URL"
for number in "$window" "$interval" "$request"; do
  [[ "$number" =~ ^[0-9]+$ ]] || die "invalid health timeout"
done
[ "$request" -gt 0 ] && [ "$interval" -gt 0 ] || die "health request and interval must be positive"
body="$(mktemp)"
trap 'rm -f "$body"' EXIT
deadline=$((SECONDS + window))
status=000
while :; do
  status="$(curl --silent --noproxy '*' --proto '=http,https' --output "$body" --max-time "$request" --write-out '%{http_code}' -- "$url" 2>/dev/null)" || status=000
  if [ "$status" = 200 ] && systemctl_user is-active --quiet "$SERVICE_NAME" && grep -qx 'mygov-tracker ok' "$body"; then
    echo "healthy: user service active, tracker identified on its port"
    exit 0
  fi
  [ "$SECONDS" -lt "$deadline" ] || break
  sleep "$interval"
done
echo "unhealthy: service or web UI check failed (last status $status)" >&2
exit 1
